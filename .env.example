# ─── Callit Environment Variables ───────────────────────────
# Copy this file to .env and fill in values
# NEVER commit .env to GitHub — it is in .gitignore

# WalletConnect Project ID — get from https://cloud.walletconnect.com
VITE_WALLETCONNECT_PROJECT_ID=your_project_id_here

# Admin Panel Password
# SECURITY RULES:
# 1. Use a strong random password (min 16 chars)
# 2. This password IS visible in the browser bundle to anyone who inspects the JS
# 3. For production, move admin auth to a backend server — never rely on client-side only
# 4. Rotate this password regularly
# 5. Never use this password anywhere else
VITE_ADMIN_PASSWORD=your_strong_random_password_here

# ─── Security Notes ──────────────────────────────────────────
# VITE_ prefix means these values are EXPOSED in the browser bundle
# Do not put private keys, secret keys, or sensitive backend credentials here
# Admin password is client-side only — for production use a proper backend auth
